{
    "name": "edulazaro/laratox",
    "description": "Content moderation for Laravel, powered by ToxicFilter",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "moderation",
        "content-moderation",
        "spam",
        "toxicity",
        "validation",
        "toxicfilter"
    ],
    "homepage": "https://toxicfilter.com/docs/sdks",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.61.1|^13.12",
        "edulazaro/toxicfilter-sdk": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\Laratox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduLazaro\\Laratox\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Edu Lazaro",
            "email": "edu@edulazaro.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\Laratox\\LaratoxServiceProvider"
            ],
            "aliases": {
                "ToxicFilter": "EduLazaro\\Laratox\\Facades\\ToxicFilter"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
